digraph DFA {
 rankdir=LR;
 start [shape=point];
 start -> 0;
 0 [shape=circle];
 1 [shape=doublecircle];
 2 [shape=doublecircle];
 3 [shape=doublecircle];
 0 -> 1 [label="a"];
 1 -> 3 [label="c"];
 1 -> 2 [label="b"];
 2 -> 3 [label="c"];
 2 -> 2 [label="b"];
 3 -> 3 [label="c"];
 3 -> 2 [label="b"];
}
